# Local development defaults — copy this file to .env, which is gitignored, so
# `npm start` picks it up automatically (see package.json:
# node --env-file-if-exists=.env).
#
#   cp .env.example .env
#
# This only matters for `npm start` run locally; the Docker image and Unraid
# template set these the normal way (container env vars) and never read
# either file.
#
# Override anything here with a real shell env var — actual process env
# always wins over --env-file.

ADMIN_PASSWORD=devpassword
DATA_DIR=./data

# Uncomment and point at a real folder to exercise the "pick from server" tab.
# Leaving it unset just hides that tab, same as in production.
# LIBRARY_DIR=./library

# PORT=8080
# PUBLIC_URL=
# MAX_MBPS=
# TRUST_PROXY=
# ALLOWED_HOSTS=
